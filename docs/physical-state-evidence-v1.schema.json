{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamaman11/mobile-proxy/docs/physical-state-evidence-v1.schema.json",
  "title": "mobile-proxy physical state evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "target",
    "source_ref",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": {
      "type": "string",
      "enum": ["OBSERVED_FACT", "MUTATION_DISPATCH_INTENT"]
    },
    "target": { "const": "android-production" },
    "source_ref": { "type": "string", "minLength": 1 },
    "authority": { "const": "CONTROL" },
    "observed_fact": { "$ref": "#/$defs/observedFact" },
    "dispatch_intent": { "$ref": "#/$defs/dispatchIntent" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_type": { "const": "OBSERVED_FACT" } },
        "required": ["evidence_type"]
      },
      "then": {
        "required": ["observed_fact"],
        "not": { "required": ["dispatch_intent"] }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": { "const": "MUTATION_DISPATCH_INTENT" }
        },
        "required": ["evidence_type"]
      },
      "then": {
        "required": ["dispatch_intent"],
        "not": { "required": ["observed_fact"] }
      }
    }
  ],
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "identity"],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^(target|observer|domain|boot|session|source|artifact|transaction)/[^\\s/][^\\s]*$"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^\\S+$"
        }
      }
    },
    "observedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "value",
        "target",
        "observation_ref",
        "source_ref",
        "dependencies",
        "authority",
        "persisted"
      ],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "target": { "const": "android-production" },
        "observation_ref": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "authority": { "const": "CONTROL" },
        "persisted": { "const": true }
      }
    },
    "dispatchIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "transaction_id",
        "step_id",
        "status",
        "affected_domain_generations",
        "persistence_precedes_dispatch",
        "blind_retry_allowed",
        "phone_command_result",
        "raw_device_identifier_recorded"
      ],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "transaction_id": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "status": { "const": "DISPATCHED" },
        "affected_domain_generations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^domain/[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "persistence_precedes_dispatch": { "const": true },
        "blind_retry_allowed": { "const": false },
        "phone_command_result": {
          "const": "UNKNOWN_AT_MARKER_TIME"
        },
        "raw_device_identifier_recorded": { "const": false }
      }
    }
  }
}
