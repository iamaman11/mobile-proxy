{
  "contract_version": 1,
  "status": "protected",
  "project_authority_contract": "contracts/operations/project-authority-v1.json",
  "source_repository": {
    "name": "iamaman11/mobile-proxy",
    "visibility": "public",
    "authority": "sole_project_source_of_truth",
    "self_hosted_runners": "forbidden"
  },
  "rulesets": {
    "main": {
      "required_check": "Quality Gate",
      "pull_request_required": true,
      "required_approvals": 0,
      "review_thread_resolution_required": true,
      "branch_must_be_up_to_date": true,
      "deletion_forbidden": true,
      "non_fast_forward_forbidden": true,
      "bypass_actors": "none"
    },
    "release_tags": {
      "pattern": "v*",
      "deletion_forbidden": true,
      "non_fast_forward_forbidden": true,
      "bypass_actors": "none"
    }
  },
  "actions_security": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "fork_pull_request_approval": "all_external_contributors",
    "fork_write_token_or_secrets": "forbidden"
  },
  "vultr_environment": {
    "name": "production-vultr",
    "allowed_ref_type": "tag",
    "allowed_ref_pattern": "v*",
    "required_reviewers": "forbidden",
    "wait_timer": "forbidden",
    "admin_bypass": "forbidden",
    "required_secret_names": [
      "VULTR_API_KEY",
      "VULTR_SSH_PRIVATE_KEY"
    ],
    "executor": "github-hosted"
  },
  "phone_control_repository": {
    "name": "iamaman11/mobile-proxy-production",
    "visibility": "private",
    "authority": "execution_only",
    "canonical_source": "iamaman11/mobile-proxy",
    "control_issue": 1,
    "preferred_logic_source": "canonical_public_logic_pinned_to_immutable_sha_or_verified_release_artifact",
    "required_device_binding_secret": "ANDROID_PRODUCTION_SERIAL",
    "reserved_android_signing_secret_names": [
      "ANDROID_RELEASE_KEYSTORE_B64",
      "ANDROID_RELEASE_KEYSTORE_PASSWORD",
      "ANDROID_RELEASE_KEY_ALIAS",
      "ANDROID_RELEASE_KEY_PASSWORD"
    ],
    "required_runner_labels": [
      "self-hosted",
      "Linux",
      "X64",
      "android-production"
    ],
    "runner_must_not_receive": [
      "VULTR_API_KEY",
      "VULTR_SSH_PRIVATE_KEY",
      "unrelated_github_pat"
    ],
    "must_not_define": [
      "project_roadmap",
      "architecture",
      "release_policy",
      "provider_desired_state",
      "acceptance_policy",
      "application_source_copy"
    ]
  },
  "release_immutability": "not_enabled_until_draft_asset_checksum_sbom_attestation_publish_order_is_implemented",
  "runtime_verification": {
    "vultr_secret_access": "pending_actions_preflight",
    "android_runner_and_device": "passed_private_actions_read_only_preflight_on_registered_device; mutable_phone_operations_remain_blocked"
  },
  "forbidden": [
    "public_repository_self_hosted_runner",
    "phone_secret_in_public_source_or_public_workflow",
    "vultr_secret_value_outside_production_vultr_environment_or_consuming_github_hosted_job",
    "public_repository_phone_adb_workflow",
    "vultr_lifecycle_before_vm_ownership_contract_implementation",
    "manual_production_ssh_or_adb_as_standard_delivery_path",
    "satellite_repository_as_project_source_of_truth"
  ]
}
