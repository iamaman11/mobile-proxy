    "secret_or_device_sensitive_values_in_public": "forbidden"
  },
  "external_runtime_state": {
    "allowed_external_values": [
      "secret_values",
      "private_keys",
      "runner_online_or_busy_state",
      "physical_usb_or_adb_state",
      "unsafe_to_publish_provider_bindings",
      "raw_sensitive_logs"
    ],
    "canonical_repository_must_define": [
      "schema",
      "invariant",
      "expected_name",
      "allowed_location",
      "safe_evidence_format"
    ]
  }
}
