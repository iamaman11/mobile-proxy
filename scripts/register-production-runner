#!/usr/bin/env bash
set -euo pipefail

: "${GH_TOKEN:?GH_TOKEN must be provided by Secret Vault}"

repo="iamaman11/mobile-proxy"
runner_dir="${RUNNER_DIR:-/home/bose/.local/share/actions-runner/mobile-proxy-production}"

test -x "$runner_dir/config.sh"
command -v gh >/dev/null

# The workstation proxy is an application data path, not a dependency of the
# GitHub control plane. A stale mobile-proxy endpoint must not take the runner
# offline.
unset ALL_PROXY all_proxy HTTPS_PROXY https_proxy HTTP_PROXY http_proxy

visibility="$(gh api "repos/$repo" --jq .visibility)"
test "$visibility" = private

registration_token=""
for attempt in 1 2 3 4 5; do
  if registration_token="$(gh api --method POST "repos/$repo/actions/runners/registration-token" --jq .token)"; then
    break
  fi
  if (( attempt == 5 )); then
    echo "Could not mint a GitHub runner registration token after $attempt attempts." >&2
    exit 1
  fi
  sleep $((attempt * 2))
done
test -n "$registration_token"
export ACTIONS_RUNNER_INPUT_TOKEN="$registration_token"
unset registration_token

cd "$runner_dir"
./config.sh \
  --unattended \
  --url "https://github.com/$repo" \
  --name "bose-mobile-proxy-production" \
  --labels "mobile-proxy-production" \
  --work "_work" \
  --replace

unset ACTIONS_RUNNER_INPUT_TOKEN
