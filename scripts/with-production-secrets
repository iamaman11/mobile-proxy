#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: scripts/with-production-secrets <command> [arguments...]" >&2
  exit 64
fi

vault="${MOBILE_PROXY_SECRET_VAULT:-/home/bose/projects/secret-vault/bin/secret-vault}"
if [[ ! -x "$vault" ]]; then
  echo "Secret Vault executable is unavailable: $vault" >&2
  exit 1
fi

exec "$vault" run mobile-proxy.admin-token MOBILE_PROXY_ADMIN_TOKEN -- \
  "$vault" run mobile-proxy.control-token MOBILE_PROXY_CONTROL_TOKEN -- \
  "$vault" run mobile-proxy.device-token MOBILE_PROXY_DEVICE_TOKEN -- \
  "$vault" run mobile-proxy.ui-token MOBILE_PROXY_UI_TOKEN -- \
  "$vault" run mobile-proxy.rotation-token MOBILE_PROXY_ROTATION_TOKEN -- \
  "$vault" run mobile-proxy.relay-user MOBILE_PROXY_RELAY_USER -- \
  "$vault" run mobile-proxy.relay-password MOBILE_PROXY_RELAY_PASSWORD -- \
  "$vault" run mobile-proxy.reverse-tunnel-cert-der-b64 MOBILE_PROXY_REVERSE_TUNNEL_CERT_DER_B64 -- \
  "$vault" run mobile-proxy.reverse-tunnel-key-der-b64 MOBILE_PROXY_REVERSE_TUNNEL_KEY_DER_B64 -- \
  "$vault" run mobile-proxy.wg-server-private-key MOBILE_PROXY_WG_SERVER_PRIVATE_KEY -- \
  "$vault" run mobile-proxy.wg-phone-public-key MOBILE_PROXY_WG_PHONE_PUBLIC_KEY -- \
  "$@"
